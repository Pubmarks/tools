# On-disk cache directory for OHLCV price history (container default: /data/cache)
# TOOLS_CACHE_DIR=/data/cache

# Rolling window of price history to cache (years, 1–30)
# TOOLS_OHLCV_CACHE_YEARS=5

# FRED API key — required for fetch_macro_data
# FRED_API_KEY=your_fred_api_key_here

# Base URL for P/E valuation-stats JSON source ({ticker} is interpolated)
# AVGPE_BASE_URL=https://example.com/stocks/{ticker}/pe-averages.json

# Server bind address
# MCP_HOST=0.0.0.0
# MCP_PORT=8080

# Log verbosity: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
