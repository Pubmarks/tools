# On-disk cache directory for OHLCV price history (container default: /data/cache)
# TOOLS_CACHE_DIR=/data/cache

# Rolling window of price history to cache (years, 1–30)
# TOOLS_OHLCV_CACHE_YEARS=5

# FRED API key — required for fetch_macro_data
# FRED_API_KEY=your_fred_api_key_here

# Base directory URL for P/E valuation-stats JSON source ({ticker} is interpolated)
# avgpe_5.json and avgpe_10.json are fetched from this path automatically
# AVGPE_BASE_URL=https://pubmarks.github.io/datasets/stocks/{ticker}

# Server bind address
# MCP_HOST=0.0.0.0
# MCP_PORT=8080

# Log verbosity: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
